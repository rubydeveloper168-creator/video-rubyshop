# Node.js Video Processor Configuration

# Server Configuration
PORT=3112

# FFmpeg Configuration
# Path to FFmpeg binary (adjust based on your system)
# For Ubuntu/Debian: /usr/bin/ffmpeg
# For macOS with Homebrew: /usr/local/bin/ffmpeg
# For Windows: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg

# Output directory for HLS files (relative to nodejs-worker directory)
OUTPUT_DIR=../public/hls

# Laravel Integration
LARAVEL_BASE_URL=https://video.rubyshop.co.th

# Logging Level (info, warn, error)
LOG_LEVEL=info
